# ===== ITSM backend environment =====
# Copy to `.env` and adjust. `.env` is gitignored.

# ---- Core ----
# PORT=4100
# NODE_ENV=production
# JWT_SECRET is REQUIRED in production (the server refuses to start without it).
# JWT_SECRET=use-a-long-random-value
# Number of proxy hops in front of the app (do NOT use 'true'); 1 for a single LB.
# TRUST_PROXY_HOPS=1
# Login brute-force lockout (defaults shown).
# LOGIN_MAX_FAILS=5
# LOGIN_WINDOW_MS=900000
# LOGIN_LOCK_MS=900000

# ---- Production first-admin bootstrap (demo accounts are NOT seeded in prod) ----
# ADMIN_EMAIL=admin@yourcompany.com
# ADMIN_PASSWORD=choose-a-strong-password   # forced to change at first login
# ADMIN_NAME=Administrator

# ---- Backups (default is a temp dir OUTSIDE the app; set a secured volume) ----
# BACKUP_DIR=/var/secure/itsm-backups
# BACKUP_RETENTION_DAYS=14

# ---- Inbound email identity (optional hardening) ----
# Your mail server's Authentication-Results authserv-id, used with the email
# channel's REQUIRE_PASS mode (Admin -> Email channel) to trust only DMARC/DKIM-
# verified senders.
# MAIL_AUTHSERV_ID=mx.yourcompany.com

# ---- Demo SMTP bridge (self-contained email demo, no real mailbox) ----
# With these set, `npm run dev` starts a local SMTP catcher + web inbox so a
# client can see every email the app sends and reply to raise/thread tickets.
#   Web inbox: http://localhost:8025   SMTP endpoint: localhost:2526
SMTP_HOST=localhost
SMTP_PORT=2526
SMTP_SECURE=false
SMTP_FROM=itsupport@cars24.com
MAIL_BRIDGE=1
MAIL_BRIDGE_SMTP_PORT=2526
MAIL_BRIDGE_WEB_PORT=8025
PORTAL_URL=http://localhost:5173
EMAIL_ALLOWED_DOMAINS=cars24.com,itsm.local

# ---- Production email (real SMTP) — set these instead of the bridge ----
# Leave MAIL_BRIDGE unset. SMTP_SECURE=true for port 465, false for 587 (STARTTLS).
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=itsupport@cars24.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=itsupport@cars24.com

# ---- Live inbound mailbox (IMAP) — enables email-to-ticket in production ----
# MAIL_IN_HOST=imap.your-provider.com
# MAIL_IN_PORT=993
# MAIL_IN_SECURE=true
# MAIL_IN_USER=itsupport@cars24.com
# MAIL_IN_PASS=your-imap-password
# MAIL_IN_FOLDER=INBOX
